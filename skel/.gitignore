# --- personal data: these must never be committed (agent.md §3) --------------
.env
.env.local
*.env
!.env.example
# The checks' tool pins (digests, no secrets): CI needs them committed.
!scripts/check-tools.env
pi.md
# The PII scan's local list of the house's own words (scripts/pii-scan.sh).
scripts/pii-scan.local
*.key
*.pem
data/

# --- MCP dev tooling ---------------------------------------------------------
mcp/.env
mcp/node_modules/
mcp/build/

# --- agent/editor local state ------------------------------------------------
# .claude/settings.json IS committed (it pre-enables this repo's own MCP server).
# settings.local.json is per-machine approval state and is not.
.claude/settings.local.json

# --- build & language junk ---------------------------------------------------
node_modules/
dist/
build/
out/
__pycache__/
*.pyc
.ruff_cache/
*.log

# --- Paranoid mode (repos that describe homelab topology) --------------------
# Swap the allow-list above for a deny-all whitelist, so a new file is ignored
# until someone deliberately un-ignores it — the only .gitignore shape that
# fails safe. See ~/Projects/homecast/.gitignore for a worked example.
#
#   /*
#   !/.gitignore
#   !/agent.md
#   !/README.md
#   ... one !/ line per tracked path ...
