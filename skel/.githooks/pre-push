#!/usr/bin/env bash
# Enabled by: git config core.hooksPath .githooks
# Last line of defence before anything leaves the machine (agent.md §3).
#
# 1. Pushes go to origin and nowhere else. This repo's history is private for
#    good: a public copy is a fresh snapshot built by scripts/mirror.sh, never
#    a push from here, so any other URL is a mistake by construction.
# 2. Never to the public side, even when origin itself points there: no repo
#    in the public org, and not the repo PUBLISH names.
# 3. scripts/check.sh fast, on exactly the commits being pushed: the PII scan,
#    commit identity and messages, secrets, workflows and shell scripts.
set -euo pipefail

url=$2
# Never echo a token someone embedded in a URL.
hide() { sed -E 's#//[^/@]*@#//#' <<<"$1"; }
# The push URL, not the fetch URL: it is what git hands this hook, and the
# two differ when origin has a pushurl.
origin=$(git remote get-url --push origin 2>/dev/null) || origin=
if [[ -z $origin || $url != "$origin" ]]; then
  cat >&2 <<MSG
pre-push: refusing to push to $(hide "$url")
  This repo's history is private and goes only to origin ($(hide "${origin:-none set}")).
  Publishing is scripts/mirror.sh's job: it builds a reviewed snapshot, so
  private history, messages and authors never reach another remote.
MSG
  exit 1
fi

# A session that set origin's URL (or only its pushurl) to the public repo
# would pass the check above. The public side is the org the mirror kit was
# made for, and whatever PUBLISH names, in the working tree or the commit.
# (In the template's own checkout the org is an unfilled placeholder, which
# matches no URL, so there only PUBLISH counts.)
public=('{{PUBLIC_OWNER}}/')
for src in PUBLISH HEAD:PUBLISH; do
  if [[ $src == PUBLISH ]]; then
    r=$(git config --file PUBLISH --get-all publish.repo 2>/dev/null) || r=
  else
    r=$(git config --blob "$src" --get-all publish.repo 2>/dev/null) || r=
  fi
  while IFS= read -r line; do [[ -z $line ]] || public+=("$line"); done <<<"$r"
done
u=${url,,}
u=${u%/}
u=${u%.git}
for p in "${public[@]}"; do
  p=${p,,}
  if [[ $u == *github.com[:/]"$p" || ( $p == */ && $u == *github.com[:/]"$p"* ) ]]; then
    cat >&2 <<MSG
pre-push: refusing to push to $(hide "$url")
  That is the public side ($p), and origin points at it. This repo's history
  is private for good: only scripts/mirror.sh's snapshot goes public, from the
  publish job. Set origin back: git remote set-url origin <the private repo>,
  and git config --unset remote.origin.pushurl if one is set.
MSG
    exit 1
  fi
done

# One line per ref: <local ref> <local sha> <remote ref> <remote sha>. The
# commits to check are the ones being pushed that no remote has yet; what is
# already on a remote was checked when it got there.
zero='^0+$'
revs=()
while read -r _ lsha _ rsha; do
  [[ $lsha =~ $zero ]] && continue    # a deletion carries no commits
  revs+=("$lsha")
  if [[ ! $rsha =~ $zero ]] && git cat-file -e "$rsha^{commit}" 2>/dev/null; then
    revs+=("^$rsha")
  fi
done
(( ${#revs[@]} )) || exit 0

check=$(git rev-parse --show-toplevel)/scripts/check.sh
[[ -f $check ]] || { echo "pre-push: scripts/check.sh is missing; run new-project.sh --adopt --refresh" >&2; exit 1; }
CHECK_RANGE="${revs[*]} --not --remotes" exec bash "$check" fast
