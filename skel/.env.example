# {{PROJECT}} configuration.
#
# Copy to `.env` (gitignored) and fill in the real values. This file is the
# committed template: it carries placeholders only — never a real IP, MAC,
# serial, hostname or token (agent.md §3).
#
# Every knob below has a reason written next to it. A knob with no reason is a
# knob to delete.

# --- example ------------------------------------------------------------------
# What it is, and why it is configurable rather than a constant.
# {{PROJECT}}_TARGET=<host-ip>

# DEBUG | INFO | WARNING
{{PROJECT_ENV}}_LOG_LEVEL=INFO
